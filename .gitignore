# ============================================================
# INVENTARIO MIEL — .gitignore
# ============================================================

# --- Entornos y secretos (NUNCA subir) ---
.env
.env.local
.env.*.local
*.env

# --- Dependencias ---
node_modules/
.pnp
.pnp.js

# --- Build outputs ---
.next/
out/
build/
dist/
target/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDEs ---
.idea/
.vscode/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# --- Maven ---
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# --- Archivos temporales ---
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
