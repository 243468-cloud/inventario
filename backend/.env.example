# Variables de entorno — Backend (Spring Boot)
# Copia este archivo como .env y rellena con valores reales NUNCA commitees el .env

# Base de datos
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/miel_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CAMBIA_ESTO_POR_TU_PASSWORD

# JWT — genera un secreto largo y aleatorio (mínimo 64 caracteres)
# Ejemplo: openssl rand -base64 64
APP_JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO_DE_AL_MENOS_64_CHARS
APP_JWT_EXPIRATION_MS=14400000

# Email SMTP (opcional)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_password_de_aplicacion
